{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "success": {
      "type": "boolean"
    },
    "limitsUpdated": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z]+$": {
          "type": "object",
          "properties": {
            "previous": {
              "type": "integer",
              "minimum": 0
            },
            "current": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "expired",
              "limitsDecreased",
              "noMember"
            ]
          },
          "decreased": {
            "type": "object",
            "patternProperties": {
              "^[a-zA-Z]+$": {
                "type": "object",
                "properties": {
                  "requested": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "current": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "required": [
          "type"
        ]
      }
    }
  }
}