{
  "name": "losant-rest",
  "version": "4.3.0",
  "description": "REST client for accessing the Losant API",
  "homepage": "https://github.com/Losant/losant-rest-js#readme",
  "author": "Losant <hello@losant.com>",
  "license": "MIT",
  "main": "lib/index.js",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "exports": {
    ".": "./lib/index.js",
    "./lib/*": "./lib/*"
  },
  "keywords": [
    "IoT",
    "platform",
    "api",
    "REST"
  ],
  "bugs": {
    "url": "https://github.com/Losant/losant-rest-js/issues"
  },
  "directories": {
    "doc": "./docs",
    "example": "./examples",
    "lib": "./lib"
  },
  "scripts": {
    "lint": "eslint *.js lib test",
    "reinstall": "rm -rf ./node_modules && pnpm install",
    "test": "mocha test 2>&1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Losant/losant-rest-js.git"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "eventsource": "^4.1.1",
    "form-data": "^4.0.6",
    "qs": "^6.16.0",
    "uri-template": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "mocha": "^11.8.0",
    "nock": "^14.0.17",
    "should": "^13.2.3"
  }
}
